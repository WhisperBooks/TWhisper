package WhisperAPI;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'whisper.cpp binding - runtime'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl;

contains
  Whisper.Types in '..\lib\Whisper.Types.pas',
  Whisper.DynLib in '..\lib\Whisper.DynLib.pas',
  Whisper.API in '..\lib\Whisper.API.pas',
  Whisper.Audio in '..\lib\Whisper.Audio.pas',
  Whisper.Core in '..\lib\Whisper.Core.pas',
  Whisper.Components in '..\lib\Whisper.Components.pas';

end.
