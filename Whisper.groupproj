<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{35EB8264-BBED-4110-9F1B-39FD3C68FBEA}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="demos\WhisperDemo\WhisperDemo.dproj">
            <Dependencies>packages\WhisperFMX.dproj</Dependencies>
        </Projects>
        <Projects Include="demos\WhisperConsole\WhisperConsole.dproj">
            <Dependencies>packages\Whisper.dproj</Dependencies>
        </Projects>
        <Projects Include="packages\Whisper.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="packages\WhisperFMX.dproj">
            <Dependencies>packages\Whisper.dproj</Dependencies>
        </Projects>
        <Projects Include="packages\dclWhisperFMX.dproj">
            <Dependencies>packages\WhisperFMX.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="WhisperDemo">
        <MSBuild Projects="demos\WhisperDemo\WhisperDemo.dproj"/>
    </Target>
    <Target Name="WhisperDemo:Clean">
        <MSBuild Projects="demos\WhisperDemo\WhisperDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="WhisperDemo:Make">
        <MSBuild Projects="demos\WhisperDemo\WhisperDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="WhisperConsole">
        <MSBuild Projects="demos\WhisperConsole\WhisperConsole.dproj"/>
    </Target>
    <Target Name="WhisperConsole:Clean">
        <MSBuild Projects="demos\WhisperConsole\WhisperConsole.dproj" Targets="Clean"/>
    </Target>
    <Target Name="WhisperConsole:Make">
        <MSBuild Projects="demos\WhisperConsole\WhisperConsole.dproj" Targets="Make"/>
    </Target>
    <Target Name="Whisper">
        <MSBuild Projects="packages\Whisper.dproj"/>
    </Target>
    <Target Name="Whisper:Clean">
        <MSBuild Projects="packages\Whisper.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Whisper:Make">
        <MSBuild Projects="packages\Whisper.dproj" Targets="Make"/>
    </Target>
    <Target Name="WhisperFMX">
        <MSBuild Projects="packages\WhisperFMX.dproj"/>
    </Target>
    <Target Name="WhisperFMX:Clean">
        <MSBuild Projects="packages\WhisperFMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="WhisperFMX:Make">
        <MSBuild Projects="packages\WhisperFMX.dproj" Targets="Make"/>
