    <Target Name="dclWhisperFMX:Make">
        <MSBuild Projects="packages\dclWhisperFMX.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Whisper;WhisperFMX;dclWhisperFMX;WhisperDemo;WhisperConsole"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Whisper:Clean;WhisperFMX:Clean;dclWhisperFMX:Clean;WhisperDemo:Clean;WhisperConsole:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Whisper:Make;WhisperFMX:Make;dclWhisperFMX:Make;WhisperDemo:Make;WhisperConsole:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
